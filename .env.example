# Berget Auth Plugin — Local Development Environment Variables
#
# Copy to .env.local and customize for your environment.
# These are read at runtime by the plugin via process.env.

# =============================================================================
# API URLs (override defaults for staging/local testing)
# =============================================================================

# Base URL for Berget API (used for token refresh, model fetching)
# Default: https://api.berget.ai
# Stage:   https://api.stage.berget.ai
# Local:   http://localhost:8080
BERGET_API_URL=https://api.stage.berget.ai

# Inference API base URL (used by OpenCode for chat completions)
# Default: https://api.berget.ai/v1
# Stage:   https://api.stage.berget.ai/v1
# Local:   http://localhost:8080/v1
BERGET_INFERENCE_URL=https://api.stage.berget.ai/v1

# =============================================================================
# Plugin Debug Logging
# =============================================================================

# Enable verbose plugin debug logging in OpenCode
# Set to "1" or "true" to see detailed plugin output
DEBUG_BERGET_AUTH=1

# =============================================================================
# OpenCode Development
# =============================================================================

# Set to 1 to run OpenCode in headless mode (no browser)
# Useful for CI or environments without a display
OPENCODE_HEADLESS=0

# Example .env.local for testing against stage:
# BERGET_API_URL=https://api.stage.berget.ai
# BERGET_INFERENCE_URL=https://api.stage.berget.ai/v1
# DEBUG_BERGET_AUTH=1
